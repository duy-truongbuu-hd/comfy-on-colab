# Copy to /content/.env or /content/drive/MyDrive/.env (or point $ENV_FILE at it).
# Every key can also be a Colab secret (Tools -> Settings -> Secrets).
# Precedence: process env > .env file > Colab secrets > defaults. Never commit a filled-in .env.

# --- Workspace ---
# Empty: /content/ComfyUI (ephemeral). Set to persist on Drive at <DRIVE_PATH>/ComfyUI.
DRIVE_PATH=/content/drive/MyDrive
# git pull ComfyUI on every setup run.
COMFY_UPDATE=true
# Port ComfyUI listens on (opened through Colab's port proxy).
COMFY_PORT=8188

# --- Persistent home (restic snapshots on Drive) ---
# Encryption key of the backup repository; losing it makes the backups unreadable. Required.
RESTIC_PASSWORD=
PERSIST_DIR=/content/drive/MyDrive/colab-persist
# Comma-separated paths to back up/restore; ~ is /root on Colab. Example: ~,/opt/blender
PERSIST_PATHS=~
PERSIST_EXCLUDES=~/.cache,~/.config/Google,~/.ipython,~/.local/share/jupyter,~/.npm/_cacache,~/.bun/install/cache
PERSIST_INTERVAL_MIN=10
# Snapshots kept by `restic forget --keep-last`.
PERSIST_KEEP=10
# System packages reinstalled on every fresh VM (space-separated), e.g. system libraries Blender needs.
PERSIST_APT_PACKAGES=
RESTIC_VERSION=0.19.1

# --- Models ---
# Comma-separated groups: qwen-image,trellis,pixal3d,3d-aux,acestep,minimax-music,stable-audio,qwen3.5
MODEL_GROUPS=qwen-image,trellis,pixal3d,3d-aux,acestep,minimax-music,stable-audio
# Files downloaded concurrently by aria2.
ARIA2_JOBS=4
# Appended as ?token= to civitai.com downloads.
CIVITAI_API_TOKEN=
